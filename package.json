{
	"name": "api-studio",
	"private": true,
	"version": "0.0.0",
	"main": "electron/main.js",
	"author": {
		"name": "Atul Jadhav"
	},
	"description": "API testing",
	"type": "module",
	"build": {
		"appId": "com.atul.apistudio",
		"productName": "API Studio",
		"files": [
			"dist/**/*",
			"electron/**/*",
			"package.json",
			".env"
		],
		"directories": {
			"output": "release"
		},
		"win": {
			"target": [
				"nsis",
				"portable"
			]
		}
	},
	"scripts": {
		"dev": "concurrently \"npm run dev:vite\" \"npm run dev:electron\"",
		"dev:vite": "vite",
		"dev:electron": "wait-on tcp:5173 && nodemon --watch electron --ext js,cjs,mjs,json --exec electron .",
		"build": "vite build",
		"preview": "vite preview",
		"electron": "electron .",
		"dist": "npm run build && electron-builder"
	},
	"dependencies": {
		"@monaco-editor/react": "^4.7.0",
		"axios": "^1.18.1",
		"dotenv": "^17.4.2",
		"lucide-react": "^1.25.0",
		"mongoose": "^9.8.0",
		"react": "^19.2.7",
		"sonner": "^2.0.7",
		"uuid": "^14.0.1",
		"zustand": "^5.0.14"
	},
	"devDependencies": {
		"@tailwindcss/vite": "^4.3.3",
		"@types/react": "^19.2.17",
		"@vitejs/plugin-react": "^6.0.3",
		"concurrently": "^10.0.3",
		"cross-env": "^10.1.0",
		"electron": "^43.1.1",
		"electron-builder": "^26.15.3",
		"electronmon": "^2.0.4",
		"nodemon": "^3.1.14",
		"oxlint": "^1.71.0",
		"tailwindcss": "^4.3.3",
		"vite": "^8.1.1",
		"wait-on": "^9.0.10"
	}
}
